{
  "cli": {
    "version": ">= 9.0.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.12.0",
      "cache": {
        "disabled": false
      }
    },
    "ios-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.12.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://beta.gomwh.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.12.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://gomwh.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
